{
  "name": "set-me-up-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Set-me-up documentation, built from the asciicn docs application",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4787",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 4787",
    "postinstall": "fumadocs-mdx",
    "typecheck": "tsc --noEmit",
    "check:docs": "bun scripts/check-docs.ts",
    "check:upstream": "bun scripts/check-upstream.ts",
    "test": "bun test scripts",
    "ci": "bun run lint && bun run check:docs && bun run check:upstream && bun run typecheck && bun run test && bun run build",
    "generate:content": "bun scripts/generate-content.ts",
    "smoke": "bun scripts/smoke-site.ts",
    "lint": "oxlint app components lib hooks constants seo scripts --deny-warnings"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@tailwindcss/postcss": "^4.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fumadocs-core": "^16.8.4",
    "fumadocs-mdx": "^14.3.1",
    "jiti": "^2.6.1",
    "jotai": "^2.19.1",
    "lru-cache": "^11.3.5",
    "motion": "^12.38.0",
    "next": "16.2.4",
    "next-themes": "0.4.6",
    "postcss": "^8.5.10",
    "radix-ui": "^1.4.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-hotkeys-hook": "^5.2.4",
    "rehype-pretty-code": "^0.14.3",
    "shiki": "^4.0.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "vaul": "^1.1.2",
    "zod": "^4.3.6",
    "mermaid": "^11.12.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.61.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "@types/bun": "^1.4.2"
  },
  "packageManager": "bun@1.3.13",
  "type": "module"
}
